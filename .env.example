# ============================================================
# SECRETS — copier ce fichier en ".env" puis remplir les valeurs
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# Le fichier .env est ignoré par Git (voir .gitignore).
# ============================================================

# --- Telegram (100% gratuit) ---
# 1. Ouvrir Telegram et parler à @BotFather
# 2. Envoyer /newbot, choisir un nom et un identifiant
# 3. BotFather renvoie un token -> le coller ci-dessous
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# 1. Parler à @userinfobot (ou @RawDataBot) sur Telegram
# 2. Il renvoie votre "Id" -> le coller ci-dessous
TELEGRAM_CHAT_ID=123456789

# Optionnel : activer/désactiver l'envoi (true/false)
TELEGRAM_ENABLED=true
